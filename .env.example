# ==========================================
# VNnettruyen - Environment Variables Configuration
# ==========================================

# Application Environment
NODE_ENV=production
PORT=3000
SESSION_SECRET=your_super_strong_session_secret_key_min_32_chars

# Database Configuration (MySQL)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=vnnettruyen_db
DB_USER=vnnettruyen_user
DB_PASSWORD=YourStrongDatabasePassword123!
MYSQL_ROOT_PASSWORD=YourStrongRootPassword123!

# phpMyAdmin Configuration
PMA_PORT=8080

# Monitoring (Prometheus & Grafana)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=YourStrongGrafanaPassword123!

# Logging (Loki)
LOKI_PORT=3100
