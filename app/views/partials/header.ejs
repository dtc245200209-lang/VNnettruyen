<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'VNnettruyen - Diễn Đàn Đọc và Sáng Tác Truyện Việt Nam' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>

  <!-- 1. Top Header Bar (Cam Vàng Rực Rỡ) -->
  <header class="top-header-bar">
    <div class="container top-header-container">
      <!-- Logo thương hiệu -->
      <a href="/" class="brand-wrapper">
        <img src="/public/images/logo.png" alt="VNnettruyen Logo" class="brand-logo-img">
        <div class="brand-text">
          <div class="brand-title">VNnet<span>truyen</span></div>
          <div class="brand-tagline">Cộng đồng đọc & sáng tác truyện</div>
        </div>
      </a>

      <!-- Thanh tìm kiếm nhanh -->
      <div class="header-search">
        <span class="search-icon">🔍</span>
        <input type="text" id="navbar-search-input" placeholder="Tìm kiếm truyện, tác giả..." autocomplete="off">
        <div id="navbar-search-results" class="search-results-dropdown"></div>
      </div>

      <!-- Khu vực nút chức năng & Tài khoản thành viên -->
      <div class="header-auth-actions">
        <!-- Nút Đăng Bài (Tùy chọn Diễn Đàn hoặc Viết Truyện) -->
        <div style="position: relative; display: inline-block;" class="post-btn-group">
          <a href="/forum/create" class="header-btn header-btn-post" style="border-radius: var(--radius-sm);">
            <span>➕</span> Đăng bài
          </a>
        </div>

        <% if (currentUser) { %>
          <a href="/profile" class="header-btn" style="background-color: rgba(255, 255, 255, 0.2);">
            <span class="user-badge-coins" id="user-header-coins">💰 <%= currentUser.coins || 50 %> Xu</span>
            <span>👤 <%= currentUser.username %></span>
          </a>
          <% if (currentUser.role === 'admin') { %>
            <a href="/admin" class="header-btn" style="background-color: #ef4444;">🛡️ Quản trị</a>
          <% } %>
          <a href="/auth/logout" class="header-btn" title="Đăng xuất">Đăng xuất</a>
        <% } else { %>
          <a href="/auth/login" class="header-btn">
            <span>➜</span> Đăng nhập
          </a>
          <a href="/auth/register" class="header-btn">
            <span>📝</span> Đăng ký
          </a>
          <a href="/auth/login" class="header-btn" style="opacity: 0.9;">
            <span>🔑</span> Quên MK
          </a>
        <% } %>
      </div>
    </div>
  </header>

  <!-- 2. Main Navigation Bar (Xanh Đen Slate) -->
  <nav class="main-nav-bar">
    <div class="container">
      <ul class="main-nav-list">
        <li class="main-nav-item">
          <a href="/" class="main-nav-link <%= currentPath === '/' ? 'active' : '' %>">Trang chủ</a>
        </li>

        <li class="main-nav-item">
          <a href="/forum" class="main-nav-link <%= currentPath.startsWith('/forum') ? 'active' : '' %>" style="color: #fbbf24; font-weight: 700;">
            💬 Diễn Đàn
          </a>
        </li>

        <li class="main-nav-item">
          <a href="/stories" class="main-nav-link <%= currentPath.startsWith('/stories') ? 'active' : '' %>">
            Đọc Truyện ▾
          </a>
          <!-- Mega-Menu thể loại truyện -->
          <div class="nav-dropdown">
            <% if (typeof genres !== 'undefined' && genres && genres.length > 0) { %>
              <% genres.forEach(g => { %>
                <a href="/stories?genre=<%= g.slug %>" class="nav-dropdown-item">
                  <span>📖</span> <%= g.name %>
                </a>
              <% }) %>
            <% } else { %>
              <a href="/stories?genre=tien-hiep" class="nav-dropdown-item"><span>⚔️</span> Tiên Hiệp</a>
              <a href="/stories?genre=kiem-hiep" class="nav-dropdown-item"><span>🗡️</span> Kiếm Hiệp</a>
              <a href="/stories?genre=da-su-viet" class="nav-dropdown-item"><span>🚩</span> Dã Sử Việt</a>
              <a href="/stories?genre=huyen-huyen" class="nav-dropdown-item"><span>✨</span> Huyền Huyễn</a>
              <a href="/stories?genre=do-thi" class="nav-dropdown-item"><span>🏙️</span> Đô Thị</a>
              <a href="/stories?genre=khoa-huyen" class="nav-dropdown-item"><span>🚀</span> Khoa Huyễn</a>
              <a href="/stories?genre=trinh-tham" class="nav-dropdown-item"><span>🔍</span> Trinh Thám</a>
              <a href="/stories?genre=kinh-di-ma-bi" class="nav-dropdown-item"><span>👻</span> Kinh Dị - Ma Bí</a>
              <a href="/stories?genre=truyen-ngan" class="nav-dropdown-item"><span>📝</span> Truyện Ngắn</a>
              <a href="/stories?genre=tieu-thuyet" class="nav-dropdown-item"><span>📚</span> Tiểu Thuyết</a>
              <a href="/stories?genre=vong-du" class="nav-dropdown-item"><span>🎮</span> Võng Du</a>
              <a href="/stories?genre=vien-tuong-ky-ao" class="nav-dropdown-item"><span>🌌</span> Viễn Tưởng</a>
              <a href="/stories?genre=tinh-cam" class="nav-dropdown-item"><span>💖</span> Tình Cảm</a>
              <a href="/stories?genre=phieu-luu-hanh-dong" class="nav-dropdown-item"><span>🏹</span> Phiêu Lưu</a>
              <a href="/stories?genre=truyen-cuoi" class="nav-dropdown-item"><span>😄</span> Truyện Cười</a>
              <a href="/stories?genre=xuyen-khong" class="nav-dropdown-item"><span>⏳</span> Xuyên Không</a>
              <a href="/stories?genre=dong-nhan" class="nav-dropdown-item"><span>🎭</span> Đồng Nhân</a>
              <a href="/stories?genre=di-gioi" class="nav-dropdown-item"><span>🌀</span> Dị Giới</a>
              <a href="/stories?genre=tan-van" class="nav-dropdown-item"><span>☕</span> Tản Văn</a>
              <a href="/stories?genre=hoc-van" class="nav-dropdown-item"><span>🎓</span> Học Văn</a>
            <% } %>
          </div>
        </li>

        <li class="main-nav-item">
          <a href="/stories?genre=tan-van" class="main-nav-link">Góc Tâm Hồn</a>
        </li>

        <li class="main-nav-item">
          <a href="/stories?genre=truyen-cuoi" class="main-nav-link">Nghệ Thuật – Giải Trí</a>
        </li>

        <li class="main-nav-item">
          <a href="/stories?genre=hoc-van" class="main-nav-link">Học Văn</a>
        </li>

        <li class="main-nav-item">
          <a href="/author" class="main-nav-link <%= currentPath.startsWith('/author') ? 'active' : '' %>">
            ✍️ Sáng Tác
          </a>
        </li>

        <li class="main-nav-item">
          <a href="/stories?sort=views" class="main-nav-link">Bảng Xếp Hạng</a>
        </li>
      </ul>
    </div>
  </nav>

  <!-- 3. Sub-genre Quick Access Strip (Dải thể loại phong phú đa dạng phong cách Vnkings) -->
  <div class="sub-genre-strip">
    <div class="container sub-genre-grid">
      <a href="/stories?genre=truyen-ngan" class="sub-genre-link">Truyện Ngắn</a>
      <a href="/stories?genre=tieu-thuyet" class="sub-genre-link">Tiểu Thuyết</a>
      <a href="/stories?genre=tien-hiep" class="sub-genre-link">Tiên Hiệp</a>
      <a href="/stories?genre=kiem-hiep" class="sub-genre-link">Kiếm Hiệp</a>
      <a href="/stories?genre=da-su-viet" class="sub-genre-link">Dã Sử Việt</a>
      <a href="/stories?genre=huyen-huyen" class="sub-genre-link">Huyền Huyễn</a>
      <a href="/stories?genre=do-thi" class="sub-genre-link">Đô Thị</a>
      <a href="/stories?genre=trinh-tham" class="sub-genre-link">Trinh Thám</a>
      <a href="/stories?genre=kinh-di-ma-bi" class="sub-genre-link">Truyện Ma – Kinh Dị</a>
      <a href="/stories?genre=vong-du" class="sub-genre-link">Võng Du</a>
      <a href="/stories?genre=vien-tuong-ky-ao" class="sub-genre-link">Viễn Tưởng – Kỳ Ảo</a>
      <a href="/stories?genre=tinh-cam" class="sub-genre-link">Tình Cảm</a>
      <a href="/stories?genre=xuyen-khong" class="sub-genre-link">Xuyên Không</a>
      <a href="/stories?genre=dong-nhan" class="sub-genre-link">Đồng Nhân</a>
      <a href="/stories?genre=di-gioi" class="sub-genre-link">Dị Giới</a>
      <a href="/stories?genre=tan-van" class="sub-genre-link">Góc Tâm Hồn</a>
      <a href="/stories?genre=hoc-van" class="sub-genre-link">Học Văn</a>
      <a href="/stories?status=completed" class="sub-genre-link">Trọn Bộ Hoàn Thành</a>
    </div>
  </div>

  <!-- Flash Messages -->
  <div class="container" style="margin-top: 15px;">
    <% if (success_msg && success_msg.length > 0) { %>
      <div style="background-color: #dcfce7; border: 1px solid #16a34a; color: #166534; padding: 12px 16px; border-radius: 6px; margin-bottom: 15px; font-weight: 600;">
        ✅ <%= success_msg %>
      </div>
    <% } %>

    <% if (error_msg && error_msg.length > 0) { %>
      <div style="background-color: #fee2e2; border: 1px solid #dc2626; color: #991b1b; padding: 12px 16px; border-radius: 6px; margin-bottom: 15px; font-weight: 600;">
        ⚠️ <%= error_msg %>
      </div>
    <% } %>
  </div>

  <main class="container" style="flex: 1;">
