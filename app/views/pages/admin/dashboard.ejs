<%- include('../../partials/header') %>

<div style="margin: 20px 0;">
  <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
    <a href="/">Trang chủ</a> &gt; <strong style="color: var(--text-main);">Khu Vực Quản Trị Hệ Thống</strong>
  </div>

  <div class="forum-card">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px; margin-bottom: 20px;">
      <div>
        <h1 style="font-size: 1.4rem; font-weight: 800; color: var(--text-main);">🛡️ Bảng Điều Khiển Quản Trị Hệ Thống</h1>
        <p style="color: var(--text-muted); font-size: 0.85rem;">VNnettruyen Administration & Observability Overview</p>
      </div>

      <div style="display: flex; gap: 8px; flex-wrap: wrap;">
        <a href="/admin/users" class="btn btn-secondary btn-sm">👥 Người dùng</a>
        <a href="/admin/stories" class="btn btn-secondary btn-sm">📚 Truyện</a>
        <a href="/admin/genres" class="btn btn-secondary btn-sm">🏷️ Thể loại</a>
        <a href="/admin/comments" class="btn btn-secondary btn-sm">💬 Bình luận</a>
      </div>
    </div>

    <!-- Stats Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
      <div style="background-color: var(--bg-card-header); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 16px; border-left: 4px solid #2563eb;">
        <div style="font-size: 0.8rem; color: var(--text-muted); font-weight: 700;">TỔNG NGƯỜI DÙNG</div>
        <div style="font-size: 1.8rem; font-weight: 800; color: #2563eb; margin-top: 4px;"><%= stats.users %></div>
      </div>

      <div style="background-color: var(--bg-card-header); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 16px; border-left: 4px solid var(--header-orange-top);">
        <div style="font-size: 0.8rem; color: var(--text-muted); font-weight: 700;">TÁC PHẨM TRUYỆN</div>
        <div style="font-size: 1.8rem; font-weight: 800; color: var(--header-orange-dark); margin-top: 4px;"><%= stats.stories %></div>
      </div>

      <div style="background-color: var(--bg-card-header); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 16px; border-left: 4px solid #16a34a;">
        <div style="font-size: 0.8rem; color: var(--text-muted); font-weight: 700;">TỔNG SỐ CHƯƠNG</div>
        <div style="font-size: 1.8rem; font-weight: 800; color: #16a34a; margin-top: 4px;"><%= stats.chapters %></div>
      </div>

      <div style="background-color: var(--bg-card-header); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 16px; border-left: 4px solid #9333ea;">
        <div style="font-size: 0.8rem; color: var(--text-muted); font-weight: 700;">BÌNH LUẬN CỘNG ĐỒNG</div>
        <div style="font-size: 1.8rem; font-weight: 800; color: #9333ea; margin-top: 4px;"><%= stats.comments %></div>
      </div>
    </div>

    <!-- Infrastructure & Monitoring Links -->
    <div style="background-color: var(--bg-card-header); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 16px; margin-bottom: 24px;">
      <div style="font-size: 0.9rem; font-weight: 700; margin-bottom: 10px; color: var(--text-main);">
        📊 Cổng Giám Sát & Quản Trị Hạ Tầng (Observability Stack)
      </div>
      <div style="display: flex; gap: 8px; flex-wrap: wrap;">
        <a href="http://localhost:3001" target="_blank" class="btn btn-secondary btn-sm">📈 Grafana Dashboard (:3001)</a>
        <a href="http://localhost:9090/targets" target="_blank" class="btn btn-secondary btn-sm">🎯 Prometheus Targets (:9090)</a>
        <a href="http://localhost:8080" target="_blank" class="btn btn-secondary btn-sm">🗄️ phpMyAdmin Database (:8080)</a>
        <a href="/metrics" target="_blank" class="btn btn-secondary btn-sm">⚡ Prometheus Metrics (/metrics)</a>
        <a href="/health" target="_blank" class="btn btn-secondary btn-sm">🩺 Healthcheck (/health)</a>
      </div>
    </div>

    <!-- 2 Column Recent Activity -->
    <div class="two-col-updates-grid" style="margin-bottom: 0;">
      <!-- Thành viên mới -->
      <div class="update-box">
        <div class="update-box-header">
          <span>👤 Thành viên mới</span>
          <a href="/admin/users">Tất cả</a>
        </div>
        <div class="data-table-wrapper" style="border: none;">
          <table class="data-table">
            <thead>
              <tr>
                <th>Username</th>
                <th>Email</th>
                <th>Vai trò</th>
              </tr>
            </thead>
            <tbody>
              <% recentUsers.forEach(u => { %>
                <tr>
                  <td><strong><%= u.username %></strong></td>
                  <td style="font-size: 0.78rem; color: var(--text-muted);"><%= u.email %></td>
                  <td>
                    <span style="font-size: 0.72rem; padding: 2px 6px; border-radius: 3px; background-color: var(--header-orange-top); color: #ffffff;"><%= u.role %></span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Bình luận mới -->
      <div class="update-box">
        <div class="update-box-header">
          <span>💬 Bình luận mới</span>
          <a href="/admin/comments">Quản lý</a>
        </div>
        <div style="display: flex; flex-direction: column; gap: 8px; padding: 10px;">
          <% recentComments.forEach(c => { %>
            <div style="padding: 8px 10px; background-color: var(--bg-card-header); border: 1px solid var(--border-color); border-radius: var(--radius-sm); font-size: 0.82rem;">
              <div style="display: flex; justify-content: space-between; margin-bottom: 2px;">
                <strong><%= c.username %></strong>
                <span style="color: var(--text-muted); font-size: 0.72rem;"><%= new Date(c.created_at).toLocaleDateString('vi-VN') %></span>
              </div>
              <div style="color: var(--text-main);"><%= c.content.slice(0, 70) %></div>
              <div style="font-size: 0.75rem; color: #2563eb; margin-top: 2px;">
                Truyện: <a href="/stories/<%= c.story_slug %>"><%= c.story_title %></a>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../../partials/footer') %>
