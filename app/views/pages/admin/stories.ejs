<%- include('../../partials/header') %>

<div style="margin: 30px 0;">
  <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 20px;">
    <a href="/admin">Quản trị</a> &gt; <strong style="color: var(--text-primary);">Quản lý Truyện</strong>
  </div>

  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
    <h1 class="section-title">📚 Quản Lý Tác Phẩm Toàn Hệ Thống (<%= stories ? stories.length : 0 %>)</h1>
    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
      <a href="/admin/users" class="btn btn-secondary btn-sm">👥 Người dùng</a>
      <a href="/admin/stories" class="btn btn-primary btn-sm">📚 Truyện</a>
      <a href="/admin/genres" class="btn btn-secondary btn-sm">🏷️ Thể loại</a>
      <a href="/admin/comments" class="btn btn-secondary btn-sm">💬 Bình luận</a>
      <a href="/admin/announcements" class="btn btn-secondary btn-sm">📢 Bảng Tin</a>
    </div>
  </div>

  <!-- Search & Filter -->
  <form action="/admin/stories" method="GET" style="display: flex; gap: 12px; margin-bottom: 24px; flex-wrap: wrap;">
    <input type="text" name="q" value="<%= query.q %>" placeholder="Tìm theo tên truyện hoặc tác giả..." class="form-control" style="max-width: 320px;">
    <select name="status" class="form-control" style="width: auto;">
      <option value="">-- Tất cả trạng thái --</option>
      <option value="ongoing" <%= query.status === 'ongoing' ? 'selected' : '' %>>Đang ra</option>
      <option value="completed" <%= query.status === 'completed' ? 'selected' : '' %>>Hoàn thành</option>
    </select>
    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    <a href="/admin/stories" class="btn btn-secondary">Đặt lại</a>
  </form>

  <div class="data-table-wrapper">
    <table class="data-table">
      <thead>
        <tr>
          <th>Bìa</th>
          <th>Tên truyện</th>
          <th>Tác giả</th>
          <th>Trạng thái</th>
          <th>Số chương</th>
          <th>Lượt xem</th>
          <th>Nổi bật</th>
          <th>Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% if (stories && stories.length > 0) { %>
          <% stories.forEach(s => { %>
            <tr>
              <td style="width: 50px;">
                <img src="<%= s.cover_image %>" alt="<%= s.title %>" style="width: 40px; height: 55px; object-fit: cover; border-radius: 4px;" onerror="this.src='/public/images/default-cover.png'">
              </td>
              <td>
                <a href="/stories/<%= s.slug %>" target="_blank" style="font-weight: 700; color: var(--accent-secondary);">
                  <%= s.title %>
                </a>
              </td>
              <td><%= s.author_name %></td>
              <td>
                <span class="badge <%= s.status === 'completed' ? 'badge-completed' : 'badge-ongoing' %>">
                  <%= s.status === 'completed' ? 'Hoàn thành' : 'Đang ra' %>
                </span>
              </td>
              <td><strong><%= s.chapter_count %></strong> ch</td>
              <td>👁️ <%= s.views %></td>
              <td>
                <form action="/admin/stories/<%= s.id %>/featured" method="POST">
                  <button type="submit" class="btn btn-sm <%= s.is_featured ? 'btn-primary' : 'btn-secondary' %>">
                    <%= s.is_featured ? '⭐ Đang Hot' : '☆ Đặt Hot' %>
                  </button>
                </form>
              </td>
              <td>
                <div style="display: flex; gap: 6px;">
                  <a href="/author/stories/<%= s.id %>/chapters" class="btn btn-secondary btn-sm" title="Quản lý chương">Chương</a>
                  <form action="/admin/stories/<%= s.id %>/delete" method="POST" class="confirm-delete" data-confirm-message="CẢNH BÁO: Xóa truyện sẽ xóa toàn bộ chương và bình luận của tác phẩm này!">
                    <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="8" style="text-align: center; padding: 30px; color: var(--text-muted);">Không có truyện nào.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../../partials/footer') %>
