<%- include('../../partials/header') %>

<div style="margin: 30px 0;">
  <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 20px;">
    <a href="/admin">Quản trị</a> &gt; <strong style="color: var(--text-primary);">Quản lý Người Dùng</strong>
  </div>

  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
    <h1 class="section-title">👥 Quản Lý Thành Viên (<%= users ? users.length : 0 %>)</h1>
  </div>

  <!-- Search & Filter -->
  <form action="/admin/users" method="GET" style="display: flex; gap: 12px; margin-bottom: 24px; flex-wrap: wrap;">
    <input type="text" name="q" value="<%= query.q %>" placeholder="Tìm theo username hoặc email..." class="form-control" style="max-width: 300px;">
    <select name="role" class="form-control" style="width: auto;">
      <option value="">-- Tất cả vai trò --</option>
      <option value="reader" <%= query.role === 'reader' ? 'selected' : '' %>>Reader</option>
      <option value="author" <%= query.role === 'author' ? 'selected' : '' %>>Author</option>
      <option value="admin" <%= query.role === 'admin' ? 'selected' : '' %>>Admin</option>
    </select>
    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    <a href="/admin/users" class="btn btn-secondary">Đặt lại</a>
  </form>

  <div class="data-table-wrapper">
    <table class="data-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Người dùng</th>
          <th>Email</th>
          <th>Vai trò hiện tại</th>
          <th>Truyện đã đăng</th>
          <th>Bình luận</th>
          <th>Ngày tạo</th>
          <th>Đổi vai trò</th>
          <th>Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% if (users && users.length > 0) { %>
          <% users.forEach(u => { %>
            <tr>
              <td><%= u.id %></td>
              <td><strong><%= u.username %></strong></td>
              <td style="color: var(--text-muted);"><%= u.email %></td>
              <td><span class="badge badge-<%= u.role %>"><%= u.role %></span></td>
              <td><%= u.stories_count %></td>
              <td><%= u.comments_count %></td>
              <td style="font-size: 0.8rem; color: var(--text-muted);"><%= new Date(u.created_at).toLocaleDateString('vi-VN') %></td>
              <td>
                <form action="/admin/users/<%= u.id %>/role" method="POST" style="display: flex; gap: 6px; align-items: center;">
                  <select name="role" class="form-control" style="width: auto; padding: 4px 8px; font-size: 0.8rem;">
                    <option value="reader" <%= u.role === 'reader' ? 'selected' : '' %>>reader</option>
                    <option value="author" <%= u.role === 'author' ? 'selected' : '' %>>author</option>
                    <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>admin</option>
                  </select>
                  <button type="submit" class="btn btn-secondary btn-sm">Lưu</button>
                </form>
              </td>
              <td>
                <% if (u.id !== currentUser.id) { %>
                  <form action="/admin/users/<%= u.id %>/delete" method="POST" class="confirm-delete" data-confirm-message="Bạn có chắc chắn muốn xóa vĩnh viễn tài khoản '<%= u.username %>'?">
                    <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                  </form>
                <% } else { %>
                  <span style="font-size: 0.8rem; color: var(--text-muted);">(Tài khoản của bạn)</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="9" style="text-align: center; padding: 30px; color: var(--text-muted);">Không tìm thấy người dùng phù hợp.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../../partials/footer') %>
