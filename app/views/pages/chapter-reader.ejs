<%- include('../partials/header') %>

<div style="margin: 20px 0;">
  <!-- Breadcrumbs -->
  <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
    <a href="/">Trang chủ</a> &gt; 
    <a href="/stories/<%= story.slug %>"><%= story.title %></a> &gt; 
    <strong style="color: var(--text-main);"><%= chapter.title %></strong>
  </div>

  <div class="reader-box">
    <!-- Reader Header -->
    <div style="text-align: center; border-bottom: 1px solid var(--border-color); padding-bottom: 20px; margin-bottom: 24px;">
      <div style="font-size: 1.1rem; color: var(--accent-link); margin-bottom: 6px;">
        <a href="/stories/<%= story.slug %>">📚 <%= story.title %></a>
      </div>
      <h1 style="font-size: 1.6rem; font-weight: 800; color: var(--text-main); line-height: 1.3;">
        <%= chapter.title %>
      </h1>
      <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 6px;">
        Cập nhật: <%= new Date(chapter.updated_at).toLocaleDateString('vi-VN') %>
      </div>

      <!-- Quick Controls -->
      <div style="display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 18px; flex-wrap: wrap;">
        <% if (prevChapter) { %>
          <a href="/stories/<%= story.slug %>/chapters/<%= prevChapter.chapter_number %>" class="btn btn-secondary btn-sm">
            &larr; Chương trước
          </a>
        <% } else { %>
          <button class="btn btn-secondary btn-sm" disabled>&larr; Chương trước</button>
        <% } %>

        <select onchange="window.location.href='/stories/<%= story.slug %>/chapters/' + this.value" class="form-control" style="width: auto; padding: 5px 10px; font-size: 0.82rem;">
          <% allChapters.forEach(c => { %>
            <option value="<%= c.chapter_number %>" <%= c.chapter_number === chapter.chapter_number ? 'selected' : '' %>>
              Chương <%= c.chapter_number %>: <%= c.title %>
            </option>
          <% }) %>
        </select>

        <% if (nextChapter) { %>
          <a href="/stories/<%= story.slug %>/chapters/<%= nextChapter.chapter_number %>" class="btn btn-secondary btn-sm">
            Chương sau &rarr;
          </a>
        <% } else { %>
          <button class="btn btn-secondary btn-sm" disabled>Chương sau &rarr;</button>
        <% } %>

        <!-- Font size & background -->
        <div style="display: flex; gap: 6px; align-items: center; margin-left: 8px;">
          <button id="btn-font-decrease" class="btn btn-secondary btn-sm" title="Giảm cỡ chữ">A-</button>
          <button id="btn-font-increase" class="btn btn-secondary btn-sm" title="Tăng cỡ chữ">A+</button>
          <select id="reader-theme-select" class="form-control" style="width: auto; padding: 5px 8px; font-size: 0.82rem;">
            <option value="default">Mặc định</option>
            <option value="sepia">📜 Giấy cũ</option>
            <option value="light">☀️ Sáng</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Chapter Content -->
    <div id="chapter-reader-content" class="reader-text">
<%= chapter.content %>
    </div>

    <!-- Bottom Navigation -->
    <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-color); padding-top: 20px; gap: 10px;">
      <% if (prevChapter) { %>
        <a href="/stories/<%= story.slug %>/chapters/<%= prevChapter.chapter_number %>" class="btn btn-secondary">
          &larr; Chương <%= prevChapter.chapter_number %>
        </a>
      <% } else { %>
        <div></div>
      <% } %>

      <a href="/stories/<%= story.slug %>" class="btn btn-primary">
        📑 Mục lục truyện
      </a>

      <% if (nextChapter) { %>
        <a href="/stories/<%= story.slug %>/chapters/<%= nextChapter.chapter_number %>" class="btn btn-secondary">
          Chương <%= nextChapter.chapter_number %> &rarr;
        </a>
      <% } else { %>
        <div></div>
      <% } %>
    </div>
  </div>

  <!-- Comments on chapter -->
  <div class="forum-card" style="max-width: 900px; margin: 24px auto;">
    <div class="top-shelf-header" style="margin-bottom: 14px;">
      <span>💬</span> Thảo luận về chương <%= chapter.chapter_number %> (<%= comments ? comments.length : 0 %>)
    </div>

    <% if (currentUser) { %>
      <form action="/comments" method="POST" style="margin-bottom: 20px;">
        <input type="hidden" name="story_id" value="<%= story.id %>">
        <input type="hidden" name="chapter_id" value="<%= chapter.id %>">
        <textarea name="content" class="form-control" rows="3" placeholder="Chia sẻ cảm nghĩ về diễn biến chương này..." required maxlength="1000" style="margin-bottom: 10px;"></textarea>
        <div style="display: flex; justify-content: flex-end;">
          <button type="submit" class="btn btn-primary">Gửi bình luận</button>
        </div>
      </form>
    <% } else { %>
      <div style="padding: 12px; background-color: var(--bg-card-header); border: 1px dashed var(--border-color); border-radius: var(--radius-sm); text-align: center; margin-bottom: 16px; font-size: 0.88rem;">
        Vui lòng <a href="/auth/login" style="color: var(--header-orange-dark); font-weight: 700;">đăng nhập</a> để bình luận.
      </div>
    <% } %>

    <div style="display: flex; flex-direction: column; gap: 10px;">
      <% if (comments && comments.length > 0) { %>
        <% comments.forEach(cmt => { %>
          <div style="padding: 10px 14px; background-color: var(--bg-card-header); border: 1px solid var(--border-color); border-radius: var(--radius-sm); font-size: 0.88rem;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
              <strong><%= cmt.username %></strong>
              <span style="font-size: 0.75rem; color: var(--text-muted);"><%= new Date(cmt.created_at).toLocaleString('vi-VN') %></span>
            </div>
            <div><%= cmt.content %></div>
          </div>
        <% }) %>
      <% } else { %>
        <div style="text-align: center; color: var(--text-muted); font-size: 0.85rem; padding: 12px;">
          Chưa có bình luận nào cho chương này.
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
