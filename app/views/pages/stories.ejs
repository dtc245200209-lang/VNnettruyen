<%- include('../partials/header') %>

<div style="margin: 20px 0;">
  <!-- Breadcrumbs -->
  <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
    <a href="/">Trang chủ</a> &gt; <strong style="color: var(--text-main);">Thư Viện Tác Phẩm</strong>
  </div>

  <div class="top-shelf-header" style="margin-bottom: 16px;">
    <span>📚</span> DANH SÁCH TIỂU THUYẾT & TRUYỆN SÁNG TÁC
  </div>

  <!-- Filter Form Bar -->
  <form action="/stories" method="GET" class="forum-filter-bar">
    <div style="flex: 2; min-width: 220px;">
      <input type="text" name="q" value="<%= query.q %>" class="form-control" placeholder="Tìm theo tên truyện hoặc tác giả...">
    </div>

    <select name="genre" class="forum-select">
      <option value="">-- Tất cả thể loại --</option>
      <% genres.forEach(g => { %>
        <option value="<%= g.slug %>" <%= query.genre === g.slug ? 'selected' : '' %>><%= g.name %></option>
      <% }) %>
    </select>

    <select name="status" class="forum-select">
      <option value="">-- Trạng thái --</option>
      <option value="ongoing" <%= query.status === 'ongoing' ? 'selected' : '' %>>Đang tiến hành</option>
      <option value="completed" <%= query.status === 'completed' ? 'selected' : '' %>>Hoàn thành</option>
    </select>

    <select name="sort" class="forum-select">
      <option value="latest" <%= query.sort === 'latest' ? 'selected' : '' %>>Mới cập nhật</option>
      <option value="views" <%= query.sort === 'views' ? 'selected' : '' %>>Lượt xem nhiều</option>
      <option value="newest" <%= query.sort === 'newest' ? 'selected' : '' %>>Mới đăng</option>
      <option value="title" <%= query.sort === 'title' ? 'selected' : '' %>>Tên A-Z</option>
    </select>

    <button type="submit" class="btn-forum-filter">Lọc truyện</button>
    <a href="/stories" class="btn btn-secondary btn-sm" style="padding: 8px 12px;">Đặt lại</a>
  </form>

  <div style="margin-bottom: 16px; font-size: 0.85rem; color: var(--text-muted);">
    Tìm thấy <strong><%= totalStories %></strong> tác phẩm phù hợp trong hệ thống.
  </div>

  <!-- Story Grid -->
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 18px; margin-bottom: 30px;">
    <% if (stories && stories.length > 0) { %>
      <% stories.forEach(story => { %>
        <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-sm); overflow: hidden; display: flex; flex-direction: column; box-shadow: var(--shadow-sm); transition: transform 0.2s;">
          <div style="position: relative; width: 100%; aspect-ratio: 2/3; overflow: hidden; background-color: #1e293b;">
            <a href="/stories/<%= story.slug %>">
              <img src="<%= story.cover_image %>" alt="<%= story.title %>" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/public/images/cover-1.jpg'">
            </a>
            <span style="position: absolute; top: 8px; left: 8px; background-color: rgba(0,0,0,0.75); color: #ffffff; padding: 2px 6px; font-size: 0.7rem; font-weight: 700; border-radius: 3px;">
              <%= story.status === 'completed' ? 'Hoàn thành' : 'Đang ra' %>
            </span>
          </div>
          <div style="padding: 12px; flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <a href="/stories/<%= story.slug %>" style="font-weight: 700; font-size: 0.9rem; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; color: var(--text-main);">
                <%= story.title %>
              </a>
              <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 4px;">
                👤 <%= story.author_name %>
              </div>
              <% if (story.latest_chapter_number) { %>
                <div style="font-size: 0.78rem; margin-top: 4px;">
                  <a href="/stories/<%= story.slug %>/chapters/<%= story.latest_chapter_number %>" style="color: #2563eb; font-weight: 600;">
                    Chương <%= story.latest_chapter_number %>
                  </a>
                </div>
              <% } %>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.72rem; color: var(--text-muted); border-top: 1px solid var(--border-color); padding-top: 8px; margin-top: 8px;">
              <span>📖 <%= story.total_chapters %> ch</span>
              <span>👁️ <%= story.views %></span>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div style="grid-column: 1 / -1; padding: 60px 20px; text-align: center; color: var(--text-muted); background-color: var(--bg-card); border: 1px dashed var(--border-color); border-radius: var(--radius-md);">
        Không tìm thấy truyện nào phù hợp với bộ lọc tìm kiếm.
      </div>
    <% } %>
  </div>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
    <div style="display: flex; justify-content: center; gap: 6px; margin: 30px 0;">
      <% if (currentPage > 1) { %>
        <a href="/stories?page=<%= currentPage - 1 %>&q=<%= query.q %>&genre=<%= query.genre %>&status=<%= query.status %>&sort=<%= query.sort %>" class="btn btn-secondary btn-sm">&laquo; Trước</a>
      <% } %>

      <% for (let i = 1; i <= totalPages; i++) { %>
        <% if (i === currentPage) { %>
          <span class="btn btn-primary btn-sm"><%= i %></span>
        <% } else if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) { %>
          <a href="/stories?page=<%= i %>&q=<%= query.q %>&genre=<%= query.genre %>&status=<%= query.status %>&sort=<%= query.sort %>" class="btn btn-secondary btn-sm"><%= i %></a>
        <% } %>
      <% } %>

      <% if (currentPage < totalPages) { %>
        <a href="/stories?page=<%= currentPage + 1 %>&q=<%= query.q %>&genre=<%= query.genre %>&status=<%= query.status %>&sort=<%= query.sort %>" class="btn btn-secondary btn-sm">Sau &raquo;</a>
      <% } %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
