<%- include('../partials/header') %>

<div style="max-width: 460px; margin: 40px auto;">
  <div class="forum-card">
    <div style="text-align: center; margin-bottom: 24px;">
      <img src="/public/images/logo.png" alt="VNnettruyen" style="width: 50px; height: 50px; border-radius: 50%; margin: 0 auto 10px; display: block;">
      <h2 style="font-size: 1.4rem; font-weight: 800; color: var(--text-main);">🔐 Đăng Nhập Diễn Đàn</h2>
      <p style="color: var(--text-muted); font-size: 0.85rem;">Cộng đồng đọc và sáng tác truyện VNnettruyen</p>
    </div>

    <form action="/auth/login" method="POST">
      <input type="hidden" name="redirect" value="<%= redirect %>">

      <div class="form-group">
        <label class="form-label">Tài khoản hoặc Email</label>
        <input type="text" name="account" class="form-control" placeholder="Nhập username hoặc email..." required autofocus>
      </div>

      <div class="form-group">
        <label class="form-label">Mật khẩu</label>
        <input type="password" name="password" class="form-control" placeholder="Nhập mật khẩu..." required>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 10px; font-size: 0.95rem; margin-top: 10px;">
        Đăng Nhập Ngay
      </button>
    </form>

    <div style="margin-top: 20px; text-align: center; font-size: 0.85rem; color: var(--text-muted);">
      Chưa có tài khoản? <a href="/auth/register" style="color: var(--header-orange-dark); font-weight: 700;">Đăng ký thành viên mới</a>
    </div>

    <div style="margin-top: 24px; padding: 12px; background-color: var(--bg-card-header); border: 1px dashed var(--border-color); border-radius: var(--radius-sm); font-size: 0.78rem; line-height: 1.6;">
      <strong style="color: #ea580c;">📌 Tài khoản kiểm thử có sẵn:</strong><br>
      • <strong>Quản trị viên:</strong> <code>admin</code> | <code>Admin@123456</code><br>
      • <strong>Tác giả:</strong> <code>tacgia_viet</code> | <code>Author@123456</code><br>
      • <strong>Độc giả:</strong> <code>docgia_vn</code> | <code>Reader@123456</code>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
