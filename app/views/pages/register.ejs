<%- include('../partials/header') %>

<div style="max-width: 480px; margin: 40px auto;">
  <div class="forum-card">
    <div style="text-align: center; margin-bottom: 24px;">
      <img src="/public/images/logo.png" alt="VNnettruyen" style="width: 50px; height: 50px; border-radius: 50%; margin: 0 auto 10px; display: block;">
      <h2 style="font-size: 1.4rem; font-weight: 800; color: var(--text-main);">📝 Đăng Ký Thành Viên</h2>
      <p style="color: var(--text-muted); font-size: 0.85rem;">Gia nhập cộng đồng đọc & sáng tác truyện Việt Nam</p>
    </div>

    <form action="/auth/register" method="POST">
      <div class="form-group">
        <label class="form-label">Tên tài khoản (Username)</label>
        <input type="text" name="username" class="form-control" placeholder="Từ 3-30 ký tự, không dấu..." required minlength="3" maxlength="30" autofocus>
      </div>

      <div class="form-group">
        <label class="form-label">Địa chỉ Email</label>
        <input type="email" name="email" class="form-control" placeholder="example@vnnettruyen.vn" required>
      </div>

      <div class="form-group">
        <label class="form-label">Mật khẩu</label>
        <input type="password" name="password" class="form-control" placeholder="Tối thiểu 6 ký tự..." required minlength="6">
      </div>

      <div class="form-group">
        <label class="form-label">Xác nhận mật khẩu</label>
        <input type="password" name="confirmPassword" class="form-control" placeholder="Nhập lại mật khẩu..." required minlength="6">
      </div>

      <div class="form-group">
        <label class="form-label">Mục đích tham gia</label>
        <select name="role" class="form-control">
          <option value="reader">📖 Độc giả (Đọc truyện, lưu tủ sách, thảo luận)</option>
          <option value="author">✍️ Tác giả (Có quyền đăng tác phẩm và quản lý chương)</option>
        </select>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 10px; font-size: 0.95rem; margin-top: 10px;">
        Hoàn Tất Đăng Ký
      </button>
    </form>

    <div style="margin-top: 20px; text-align: center; font-size: 0.85rem; color: var(--text-muted);">
      Đã có tài khoản? <a href="/auth/login" style="color: var(--header-orange-dark); font-weight: 700;">Đăng nhập ngay</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
