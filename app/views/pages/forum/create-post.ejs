<%- include('../../partials/header') %>

<div style="max-width: 860px; margin: 25px auto;">
  <!-- Breadcrumbs -->
  <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
    <a href="/">Trang chủ</a> &gt; <a href="/forum">Diễn đàn</a> &gt; <strong style="color: var(--text-main);">Đăng bài viết mới</strong>
  </div>

  <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm);">
    <div style="background-color: var(--nav-dark); color: #ffffff; padding: 14px 20px; font-weight: 700; font-size: 1.1rem; display: flex; align-items: center; gap: 8px;">
      <span>✏️</span> TẠO BÀI VIẾT THẢO LUẬN DIỄN ĐÀN
    </div>

    <form action="/forum/create" method="POST" style="padding: 24px;">
      <!-- Chọn Chuyên Mục -->
      <div style="margin-bottom: 18px;">
        <label for="category_id" style="display: block; font-weight: 700; margin-bottom: 6px; font-size: 0.9rem;">
          Chuyên mục thảo luận <span style="color: #ef4444;">*</span>
        </label>
        <select name="category_id" id="category_id" class="form-control" required style="width: 100%; padding: 10px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); background-color: var(--bg-card); color: var(--text-main); font-size: 0.9rem;">
          <option value="">-- Chọn chuyên mục diễn đàn phù hợp --</option>
          <% if (categories && categories.length > 0) { %>
            <% categories.forEach(cat => { %>
              <option value="<%= cat.id %>" <%= preSelectedCat == cat.id ? 'selected' : '' %>>
                <%= cat.name %>
              </option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <!-- Tiêu đề bài viết -->
      <div style="margin-bottom: 18px;">
        <label for="title" style="display: block; font-weight: 700; margin-bottom: 6px; font-size: 0.9rem;">
          Tiêu đề bài viết <span style="color: #ef4444;">*</span>
        </label>
        <input type="text" name="title" id="title" class="form-control" placeholder="Ví dụ: [Sáng Tác] Chia sẻ kinh nghiệm tạo cốt truyện gay cấn..." required minlength="5" maxlength="255" spellcheck="false" style="width: 100%; padding: 10px 12px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); background-color: var(--bg-card); color: var(--text-main); font-size: 0.95rem;">
        <small style="color: var(--text-muted); font-size: 0.78rem; display: block; margin-top: 4px;">
          Gợi ý: Thêm tiền tố như [Thảo Luận], [Review], [Sáng Tác], [Hỏi Đáp] giúp bài viết nổi bật và dễ tìm kiếm.
        </small>
      </div>

      <!-- Nội dung bài viết -->
      <div style="margin-bottom: 24px;">
        <label for="content" style="display: block; font-weight: 700; margin-bottom: 6px; font-size: 0.9rem;">
          Nội dung chi tiết <span style="color: #ef4444;">*</span>
        </label>
        <textarea name="content" id="content" rows="12" class="form-control" placeholder="Nhập nội dung chia sẻ, đàm đạo hoặc câu hỏi của bạn tại đây..." required minlength="10" spellcheck="false" style="width: 100%; padding: 12px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); background-color: var(--bg-card); color: var(--text-main); font-family: var(--font-main); font-size: 0.95rem; line-height: 1.6;"></textarea>
      </div>

      <div style="background-color: var(--bg-body); padding: 14px; border-radius: var(--radius-sm); margin-bottom: 20px; font-size: 0.85rem; color: var(--text-muted);">
        📌 <strong>Quy định diễn đàn:</strong> Hãy viết bài đúng chuyên mục, dùng tiếng Việt có dấu rõ ràng, không spam quảng cáo và tôn trọng các thành viên khác.
      </div>

      <!-- Nút hành động -->
      <div style="display: flex; justify-content: flex-end; gap: 12px;">
        <a href="/forum" class="btn btn-secondary">Hủy bỏ</a>
        <button type="submit" class="btn btn-primary" style="padding: 10px 24px; font-weight: 700;">
          🚀 Đăng bài viết ngay
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../../partials/footer') %>
