<%- include('../../partials/header') %>

<div style="margin: 20px 0;">
  <!-- Breadcrumbs & Nút Quay Lại -->
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
    <div style="font-size: 0.85rem; color: var(--text-muted);">
      <a href="/">Trang chủ</a> &gt; 
      <a href="/forum">Diễn đàn</a> &gt; 
      <a href="/forum/categories/<%= post.category_slug %>"><%= post.category_name %></a> &gt; 
      <strong style="color: var(--text-main);"><%= post.title %></strong>
    </div>

    <div>
      <a href="/forum/categories/<%= post.category_slug %>" class="btn btn-secondary btn-sm">
        ⬅️ Quay lại chuyên mục
      </a>
    </div>
  </div>

  <!-- HỘP BÀI VIẾT CHÍNH (THREAD STARTER) -->
  <div class="forum-thread-post" style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); margin-bottom: 24px;">
    <!-- Tiêu đề & Thông tin Meta -->
    <div style="background-color: var(--bg-card-header); padding: 14px 20px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
      <div>
        <span style="background-color: rgba(245, 158, 11, 0.15); color: var(--accent-link); font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 4px; margin-right: 8px;">
          <%= post.category_name %>
        </span>
        <h1 style="display: inline; font-size: 1.25rem; font-weight: 800; color: var(--text-main);">
          <%= post.title %>
        </h1>
      </div>

      <div style="font-size: 0.8rem; color: var(--text-muted); display: flex; gap: 12px;">
        <span>📅 <%= new Date(post.created_at).toLocaleString('vi-VN') %></span>
        <span>👁️ <%= post.views %> lượt xem</span>
      </div>
    </div>

    <!-- Layout 2 cột: Cột trái Thông tin Tác Giả, Cột phải Nội dung bài viết -->
    <div style="display: grid; grid-template-columns: 200px 1fr; min-height: 220px;">
      <!-- Cột Trái: Thông tin Người Đăng -->
      <div style="background-color: var(--bg-body); padding: 20px; border-right: 1px solid var(--border-color); text-align: center; font-size: 0.82rem;">
        <img src="<%= post.author_avatar || '/public/images/default-avatar.png' %>" alt="<%= post.author_name %>" style="width: 72px; height: 72px; border-radius: 50%; object-fit: cover; border: 2px solid var(--border-color); margin-bottom: 10px;" onerror="this.src='/public/images/logo.png'">
        <div style="font-weight: 800; font-size: 0.95rem; color: var(--text-main); margin-bottom: 4px;">
          <%= post.author_name %>
        </div>

        <div style="margin-bottom: 10px;">
          <% if (post.author_role === 'admin') { %>
            <span style="background-color: #ef4444; color: #ffffff; font-size: 0.7rem; font-weight: 700; padding: 2px 8px; border-radius: 9999px;">Quản Trị Viên</span>
          <% } else if (post.author_role === 'author') { %>
            <span style="background-color: #f59e0b; color: #ffffff; font-size: 0.7rem; font-weight: 700; padding: 2px 8px; border-radius: 9999px;">Tác Giả</span>
          <% } else { %>
            <span style="background-color: #3b82f6; color: #ffffff; font-size: 0.7rem; font-weight: 700; padding: 2px 8px; border-radius: 9999px;">Thành Viên</span>
          <% } %>
        </div>

        <div style="color: var(--text-muted); font-size: 0.75rem; display: flex; flex-direction: column; gap: 4px; text-align: left; margin-top: 10px; border-top: 1px solid var(--border-color); padding-top: 10px;">
          <div>💰 Xu: <strong style="color: #d97706;"><%= post.author_coins || 0 %></strong></div>
          <div>📝 Bài viết: <strong><%= post.author_post_count || 1 %></strong></div>
          <div>📅 Tham gia: <%= new Date(post.author_joined).toLocaleDateString('vi-VN') %></div>
        </div>
      </div>

      <!-- Cột Phải: Nội Dung Bài Viết -->
      <div style="padding: 24px; display: flex; flex-direction: column; justify-content: space-between;">
        <div style="font-size: 0.98rem; line-height: 1.8; color: var(--text-main); white-space: pre-line;">
          <%- post.content %>
        </div>

        <!-- Chân bài viết / Nút hành động -->
        <div style="margin-top: 24px; padding-top: 14px; border-top: 1px dashed var(--border-color); display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; color: var(--text-muted);">
          <div>
            <em>VNnettruyen - Diễn đàn văn học & cộng đồng tác giả Việt</em>
          </div>

          <div style="display: flex; gap: 8px;">
            <% if (currentUser && (currentUser.id === post.user_id || currentUser.role === 'admin')) { %>
              <form action="/forum/posts/<%= post.id %>/delete" method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bài viết này không? Toàn bộ bình luận liên quan cũng sẽ bị xóa!');" style="display: inline;">
                <button type="submit" class="btn btn-secondary btn-sm" style="color: #ef4444; border-color: #fca5a5;">
                  🗑️ Xóa bài viết
                </button>
              </form>
            <% } %>
            <a href="#reply-form" class="btn btn-primary btn-sm">
              💬 Trả lời thảo luận
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- DANH SÁCH CÁC PHẢN HỒI / BÌNH LUẬN (REPLIES) -->
  <div id="replies" style="margin-bottom: 30px;">
    <div style="font-size: 1.1rem; font-weight: 800; color: var(--text-main); margin-bottom: 16px; display: flex; align-items: center; gap: 8px;">
      <span>💬</span> CÁC PHẢN HỒI THẢO LUẬN (<%= replies ? replies.length : 0 %>)
    </div>

    <% if (replies && replies.length > 0) { %>
      <% replies.forEach((reply, index) => { %>
        <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-md); overflow: hidden; margin-bottom: 16px; box-shadow: var(--shadow-sm);">
          <div style="background-color: var(--bg-card-header); padding: 8px 16px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; font-size: 0.78rem; color: var(--text-muted);">
            <span>#<%= index + 1 %> • Đăng lúc <%= new Date(reply.created_at).toLocaleString('vi-VN') %></span>
            <% if (currentUser && (currentUser.id === reply.user_id || currentUser.role === 'admin')) { %>
              <form action="/forum/replies/<%= reply.id %>/delete" method="POST" onsubmit="return confirm('Xác nhận xóa bình luận này?');" style="display: inline;">
                <button type="submit" style="background: none; border: none; color: #ef4444; cursor: pointer; font-size: 0.75rem;">
                  🗑️ Xóa
                </button>
              </form>
            <% } %>
          </div>

          <div style="display: grid; grid-template-columns: 180px 1fr;">
            <!-- Thông tin thành viên bình luận -->
            <div style="background-color: var(--bg-body); padding: 14px; border-right: 1px solid var(--border-color); text-align: center; font-size: 0.8rem;">
              <img src="<%= reply.avatar || '/public/images/default-avatar.png' %>" alt="<%= reply.username %>" style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover; margin-bottom: 6px;" onerror="this.src='/public/images/logo.png'">
              <div style="font-weight: 700; color: var(--text-main);"><%= reply.username %></div>
              <div style="margin-top: 4px;">
                <% if (reply.role === 'admin') { %>
                  <span style="background-color: #ef4444; color: #ffffff; font-size: 0.65rem; font-weight: 700; padding: 1px 6px; border-radius: 9999px;">BQT</span>
                <% } else if (reply.role === 'author') { %>
                  <span style="background-color: #f59e0b; color: #ffffff; font-size: 0.65rem; font-weight: 700; padding: 1px 6px; border-radius: 9999px;">Tác Giả</span>
                <% } else { %>
                  <span style="background-color: #3b82f6; color: #ffffff; font-size: 0.65rem; font-weight: 700; padding: 1px 6px; border-radius: 9999px;">Thành Viên</span>
                <% } %>
              </div>
            </div>

            <!-- Nội dung phản hồi -->
            <div style="padding: 18px; font-size: 0.92rem; line-height: 1.7; color: var(--text-main); white-space: pre-line;">
              <%- reply.content %>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 30px; text-align: center; color: var(--text-muted); margin-bottom: 20px;">
        Chưa có phản hồi nào cho bài viết này. Hãy là người đầu tiên tham gia thảo luận!
      </div>
    <% } %>
  </div>

  <!-- FORM GỬI PHẢN HỒI (REPLY FORM) -->
  <div id="reply-form" style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm);">
    <div style="background-color: var(--nav-dark); color: #ffffff; padding: 12px 18px; font-weight: 700; font-size: 0.95rem;">
      ✍️ GỬI PHẢN HỒI THẢO LUẬN
    </div>

    <% if (currentUser) { %>
      <form action="/forum/reply" method="POST" style="padding: 20px;">
        <input type="hidden" name="postId" value="<%= post.id %>">
        <input type="hidden" name="postSlug" value="<%= post.slug %>">

        <div style="margin-bottom: 14px;">
          <textarea name="content" rows="4" class="form-control" placeholder="Nhập ý kiến đóng góp, thảo luận của bạn tại đây..." required minlength="3" style="width: 100%; padding: 12px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); background-color: var(--bg-card); color: var(--text-main); font-family: var(--font-main); font-size: 0.92rem;"></textarea>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center;">
          <span style="font-size: 0.78rem; color: var(--text-muted);">
            🎁 Thưởng <strong>+1 Xu</strong> cho mỗi phản hồi tích cực đóng góp cộng đồng.
          </span>
          <button type="submit" class="btn btn-primary" style="padding: 8px 20px; font-weight: 700;">
            Gửi phản hồi
          </button>
        </div>
      </form>
    <% } else { %>
      <div style="padding: 30px; text-align: center;">
        <p style="color: var(--text-muted); margin-bottom: 12px;">
          Bạn cần đăng nhập tài khoản để tham gia gửi bình luận thảo luận.
        </p>
        <a href="/auth/login?redirect=/forum/posts/<%= post.slug %>" class="btn btn-primary" style="padding: 8px 18px;">
          Đăng nhập ngay
        </a>
      </div>
    <% } %>
  </div>
</div>

<%- include('../../partials/footer') %>
